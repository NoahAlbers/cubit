{$CUBIT_HOSTNAME} {
    encode zstd gzip
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options nosniff
        Referrer-Policy same-origin
        X-Frame-Options DENY
        X-Robots-Tag "noindex, nofollow"
    }
    reverse_proxy 127.0.0.1:5001
}

https://{$CUBIT_HOSTNAME}:8443 {
    encode zstd gzip
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options nosniff
        Referrer-Policy same-origin
        X-Robots-Tag "noindex, nofollow"
    }
    request_body {
        max_size 15MB
    }
    # Local operator access (for example an SSH tunnel) keeps the admin UI private.
    # Add an approved administrator IP here only through the operator's change process.
    @private_admin remote_ip 127.0.0.1 ::1
    handle @private_admin {
        reverse_proxy 127.0.0.1:3000
    }
    @signing path /s/* /submit_form* /p/* /success /file/* /blobs_proxy/* /rails/active_storage/* /preview/* /assets/* /packs/* /js/* /favicon* /apple-touch-icon* /apple-icon* /api/attachments /api/submitter_form_views /api/submitter_email_clicks
    handle @signing {
        reverse_proxy 127.0.0.1:3000
    }
    handle {
        respond 404
    }
}
