# PostgreSQL connection string
DATABASE_URL=

# NextAuth — generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Resend (transactional email)
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@melbournemakerspace.org

# Seeded super-admin email
ADMIN_EMAIL=admin@melbournemakerspace.org

# Shared secret for the daily automation cron (Vercel Cron sends it as a Bearer token)
CRON_SECRET=

# PayPal sync — REST app credentials from developer.paypal.com
# Enable "Transaction Search" on the app for the scheduled sync.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# "live" or "sandbox" (default sandbox)
PAYPAL_MODE=live
# Webhook id after registering https://<your-app>/api/paypal/webhook
PAYPAL_WEBHOOK_ID=
