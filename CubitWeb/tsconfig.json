{
  "compileOnSave": false,
  "compilerOptions": {
    "outDir": "./dist/out-tsc",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "experimentalDecorators": true,
    "target": "ES2022",
    "typeRoots": [
      "node_modules/@types"
    ],
    "module": "ES2022",
    "useDefineForClassFields": false,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "strict": false,
    "esModuleInterop": true
  },
  "angularCompilerOptions": {
    "strictTemplates": false
  }
}
